DISCORD_TOKEN=ใส่_token_บอท_ตรงนี้
# ใส่หลายคีย์คั่นด้วย comma ระบบจะวนสลับอัตโนมัติเมื่อโดน limit
GEMINI_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.5-flash-lite
# ช่องที่ให้ตอบทุกข้อความ (ใส่ channel ID คั่น comma) เว้นว่าง = ตอบเฉพาะตอน mention + DM
AUTO_REPLY_CHANNEL_IDS=
# ชื่อบอทใน prompt ของ agent (default = ชื่อ Discord ของบอท)
BOT_NAME=
# โทเค็นแอดมินสำหรับหน้าเว็บ dashboard (เว้นว่าง = ปุ่มเขียนใช้ไม่ได้)
ADMIN_TOKEN=
# พอร์ตเว็บ local (Render ใส่ PORT ให้เอง)
PORT=8080
# SYSTEM_PROMPT=You are a helpful assistant...
