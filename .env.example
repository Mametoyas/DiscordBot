DISCORD_TOKEN=ใส่_token_บอท_ตรงนี้
# ใส่หลายคีย์คั่นด้วย comma ระบบจะวนสลับอัตโนมัติเมื่อโดน limit
GEMINI_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq key (console.groq.com, free) — needed for openai/gpt-oss-* backbones
GROQ_API_KEY=
# ช่องที่ให้ตอบทุกข้อความ (ใส่ channel ID คั่น comma) เว้นว่าง = ตอบเฉพาะตอน mention + DM
AUTO_REPLY_CHANNEL_IDS=
# ชื่อบอทใน prompt ของ agent (default = ชื่อ Discord ของบอท)
BOT_NAME=
# โทเค็นแอดมินสำหรับหน้าเว็บ dashboard (เว้นว่าง = ปุ่มเขียนใช้ไม่ได้)
ADMIN_TOKEN=
# พอร์ตเว็บ local (Render ใส่ PORT ให้เอง)
PORT=8080
# --- Chat memory (Supabase, optional — falls back to in-memory) ---
# 1) supabase.com → New project (free, region Singapore)
# 2) SQL Editor → run the CREATE TABLE in src/utils/chat_store.py (SUPABASE_SETUP)
# 3) Settings → API → paste Project URL + service_role key below
SUPABASE_URL=
SUPABASE_KEY=
# newest pairs kept per user/channel (default 20), rows older than N days pruned
CHAT_KEEP_PAIRS=20
CHAT_RETENTION_DAYS=30
# history rows above this get compressed into a summary (default 60)
CHAT_COMPRESS_AT=60
# SYSTEM_PROMPT=You are a helpful assistant...
